{
  "name": "dsa-insights-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "backend:dev": "cd backend && mvnw.cmd spring-boot:run",
    "backend:build": "cd backend && mvnw.cmd clean package",
    "backend:run": "cd backend && mvnw.cmd spring-boot:run",
    "fullstack:build": "npm run build && npm run backend:build",
    "python:install": "pip3 install -r requirements.txt",
    "python:start": "python3 python_server.py",
    "python:dev": "python3 python_server.py"
  },
  "dependencies": {
    "@clerk/react": "^6.9.1",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.2.1",
    "mongoose": "^8.24.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cors": "^2.8.6",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
